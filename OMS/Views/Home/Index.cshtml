@model OMS.Models.HomeViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var dashboard = Model.Dashboard;
    var selectedEventId = Context.Request.Query["eventId"].ToString();
    var selectedEvent = Model.Events.FirstOrDefault(item => item.EventId == selectedEventId)
        ?? Model.Events.FirstOrDefault(item => item.Status is "Ongoing" or "Published")
        ?? Model.Events.FirstOrDefault();
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "VIEWER";
    var canCheckIn = role is "SUPERADMIN" or "ADMIN" or "REGISTRATION";
    var canManage = role is "SUPERADMIN" or "ADMIN";
    ViewData["Title"] = Model.Page switch
    {
        "scanner" => "Scanner Check-in",
        "participants" => "Peserta & QR",
        "data" => "Kegiatan & Laporan",
        _ => "Dashboard"
    };
}
<div class="app-shell" data-page="@Model.Page" data-can-manage="@canManage.ToString().ToLowerInvariant()">
    <aside class="sidebar" id="primary-navigation" aria-label="Menu">
        <a class="brand" href="/" aria-label="WOM Finance - OMS">
            <img class="brand-logo" src="~/img/LogoWOMF.png" alt="" />
            <span class="brand-copy"><strong>OMS</strong><small>OUTING MANAGEMENT SYSTEM</small></span>
        </a>
        <nav class="sidebar-nav">
            <div class="nav-label">MENU</div>
            <a class="nav-item @(Model.Page == "dashboard" ? "active" : "")" href="/?page=dashboard&eventId=@selectedEvent?.EventId"><span>▦</span> Dashboard</a>
            @if (canCheckIn)
            {
                <a class="nav-item @(Model.Page == "scanner" ? "active" : "")" href="/?page=scanner&eventId=@selectedEvent?.EventId"><span>▣</span> Scanner Check-in</a>
                <a class="nav-item @(Model.Page == "participants" ? "active" : "")" href="/?page=participants&eventId=@selectedEvent?.EventId"><span>♙</span> Peserta & QR</a>
            }
            @if (role is "SUPERADMIN" or "ADMIN" or "VIEWER")
            {
                <a class="nav-item @(Model.Page == "data" ? "active" : "")" href="/?page=data&eventId=@selectedEvent?.EventId"><span>▤</span> Kegiatan & Laporan</a>
            }
        </nav>
        <div class="sidebar-footer">
            <div class="user-meta"><strong>@(User.FindFirst("oms:full_name")?.Value ?? User.Identity?.Name ?? "Panitia")</strong></div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="ms-auto">
                @Html.AntiForgeryToken()
                <button class="logout-button" type="submit" title="Keluar">↗</button>
            </form>
        </div>
    </aside>
    <button class="menu-backdrop" type="button" aria-label="Tutup menu" tabindex="-1"></button>
    <main class="main-area">
        <header class="topbar">
            <div class="topbar-heading">
                <button class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="primary-navigation">
                    <span></span><span></span><span></span>
                </button>
                <div><div class="eyebrow">OUTING MANAGEMENT SYSTEM</div><h1>@ViewData["Title"]</h1></div>
            </div>
            <div class="topbar-actions">
                @if (Model.Events.Count > 0)
                {
                    <select id="event-select" class="form-select event-select" aria-label="Pilih kegiatan">
                        @foreach (var item in Model.Events)
                        {
                            <option value="@item.EventId" selected="@(item.EventId == selectedEvent?.EventId ? "selected" : null)">@item.EventName (@item.Status)</option>
                        }
                    </select>
                }
                @if (canManage && Model.Page == "data")
                {
                    <a class="btn btn-primary" href="#new-event-form">+ Kegiatan</a>
                }
                <span class="user-email">@User.FindFirst("email")?.Value</span>
            </div>
        </header>
        <section class="page-content">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            else if (Model.Events.Count == 0 && Model.Page != "data")
            {
                <div class="panel empty-state"><h2>Belum ada kegiatan</h2><p>Buat kegiatan untuk mulai menggunakan dashboard</p>
                    @if (canManage)
                    {
                        <a class="btn btn-primary mt-2" href="/?page=data">Buat kegiatan pertama</a>
                    }
                </div>
            }
            else if (Model.Page == "dashboard" && dashboard is not null)
            {
                <div class="welcome-panel">
                    <div><span class="welcome-tag">KEGIATAN</span><h2 id="event-name">@dashboard.Event.EventName</h2><p>@dashboard.Event.StartDate · @dashboard.Event.Location · @dashboard.Event.Status</p></div>
                </div>
                <div class="stats-grid">
                    <article class="stat-card"><span>Total peserta</span><strong id="stat-total">@dashboard.Total</strong><small>Peserta aktif terdaftar</small></article>
                    <article class="stat-card"><span>Hadir</span><strong id="stat-attended">@dashboard.Attended</strong><small>Sudah check-in</small></article>
                    <article class="stat-card"><span>Belum hadir</span><strong id="stat-absent">@dashboard.Absent</strong><small>Belum tercatat check-in</small></article>
                    <article class="stat-card"><span>Kehadiran</span><strong id="stat-percent">@dashboard.AttendancePercent%</strong><div class="progress mt-2"><div id="attendance-progress" class="progress-bar" style="width:@dashboard.AttendancePercent%"></div></div></article>
                </div>
                <p id="dashboard-sync-status" class="dashboard-sync-status" role="status">Pembaruan otomatis setiap 15 detik</p>
                <div class="content-grid">
                    <article class="panel"><div class="panel-heading"><div><h3>Kehadiran per departemen</h3><p>Ringkasan check-in kegiatan</p></div></div>
                        <div class="table-responsive"><table class="table"><thead><tr><th>Departemen</th><th>Peserta</th><th>Hadir</th><th>Progres</th></tr></thead>
                            <tbody id="department-body">
                                @foreach (var department in dashboard.Departments)
                                {
                                    var percent = department.Total == 0 ? 0 : Math.Round(department.Attended * 100d / department.Total);
                                    <tr><td>@department.Department</td><td>@department.Total</td><td>@department.Attended</td><td><div class="progress"><div class="progress-bar" style="width:@percent%"></div></div></td></tr>
                                }
                            </tbody>
                        </table></div>
                    </article>
                    <article class="panel"><div class="panel-heading"><div><h3>Check-in terbaru</h3><p>Transaksi check-in terakhir</p></div></div>
                        <div id="recent-list" class="activity-list">
                            @foreach (var item in dashboard.Recent)
                            {
                                <div class="activity-item"><span class="activity-dot"></span><div><strong>@item.FullName</strong><small>@item.EmployeeNumber · @item.Department · @item.AttendanceTime</small></div></div>
                            }
                        </div>
                    </article>
                </div>
                <article class="panel mt-4"><div class="panel-heading"><div><h3>Belum check-in</h3><p>Menampilkan maksimal 30 peserta</p></div><a class="btn btn-sm btn-outline-primary" href="/?page=participants&eventId=@selectedEvent?.EventId">Cari peserta</a></div>
                    <div id="absent-list" class="absent-list">
                        @foreach (var item in dashboard.AbsentParticipants)
                        {
                            <span class="absent-chip">@item.FullName · @item.EmployeeNumber</span>
                        }
                    </div>
                </article>
            }
            else if (Model.Page == "scanner" && canCheckIn)
            {
                @* <div class="workspace-intro"><div><h2>Check-in peserta</h2><p>Scan pertama akan mencatat check-in, dan ketika di scan ulang tidak mengubah statusnya, sedangkan untuk check-out perlu dikonfirmasi operator</p></div></div> *@
                <article class="panel session-toolbar"><label class="form-label mb-0" for="session-select">Sesi check-in</label><select id="session-select" class="form-select"><option value="">Check-in umum kegiatan</option></select></article>
                <div id="scan-result-area" aria-live="polite" aria-atomic="true"></div>
                <div id="checkout-confirmation" class="alert alert-warning checkout-confirmation d-none" role="status" aria-live="polite">
                    <div>
                        <strong>Peserta sudah check-in</strong>
                        <div id="checkout-participant"></div>
                    </div>
                    <button id="confirm-checkout" class="btn btn-warning" type="button">Konfirmasi Check-out</button>
                </div>
                <div class="scanner-workspace">
                    <article class="panel">
                        <div class="panel-heading"><div><h3>Scan QR</h3><p>Kamera aktif hanya saat tombol Mulai kamera ditekan</p></div></div>
                        <div id="qr-reader"></div>
                        <div class="button-row mt-3"><button id="start-scan" class="btn btn-primary" onclick="startScanner()">Mulai kamera</button><button id="stop-scan" class="btn btn-outline-secondary" onclick="stopScanner()" disabled>Hentikan</button><button class="btn btn-outline-secondary" onclick="document.getElementById('qr-image').click()">Pilih foto QR</button></div>
                        <div id="scan-message" class="camera-help mt-3">Kamera memerlukan HTTPS (atau localhost), izin dari browser, dan perangkat kamera yang tersedia</div>
                        <input id="qr-image" type="file" accept="image/*" capture="environment" class="d-none" onchange="scanImage(this.files[0]);this.value=''">
                    </article>
                    <article class="panel manual-checkin-panel">
                        <div class="panel-heading"><div><h3>Check-in manual</h3><p>Masukkan NIK peserta, pilih hasil yang cocok, lalu konfirmasi</p></div></div>
                        <label class="form-label" for="manual-search">NIK peserta</label>
                        <div class="input-group"><input id="manual-search" class="form-control" autocomplete="off" placeholder="Ketik NIK atau nama"><button class="btn btn-primary" id="manual-search-button" type="button">Cari</button></div>
                        <div id="manual-results" class="manual-results mt-3" aria-live="polite"></div>
                    </article>
                </div>
            }
            else if (Model.Page == "participants" && canCheckIn)
            {
                <div class="workspace-intro"><div><h2>Peserta & QR</h2><p>Cari dan kelola peserta untuk kegiatan terpilih</p></div>
                    @if (canManage)
                    {
                        <div class="button-row"><button class="btn btn-outline-secondary" onclick="document.getElementById('employee-master-file').click()">Unggah master CSV</button><button class="btn btn-outline-primary" onclick="importMaster()">Impor master karyawan</button><button class="btn btn-outline-primary" id="add-participant">+ Tambah peserta</button><button class="btn btn-primary" id="send-invitations" onclick="sendInvitations()">Kirim semua undangan</button><input id="employee-master-file" type="file" accept=".csv,text/csv" class="d-none"></div>
                    }
                </div>
                @if (canManage)
                {
                    <div id="invite-progress" class="alert alert-info d-none" role="status"></div>
                    <article id="participant-form-panel" class="panel mb-4 d-none">
                        <div class="panel-heading"><div><h3 id="participant-form-title">Tambah peserta</h3><p>Kolom NIK dan nama wajib diisi. Kolom lainnya dapat dilengkapi atau diperbaiki.</p></div></div>
                        <form id="participant-form">
                            <input id="participant-edit-id" type="hidden">
                            <div class="row g-3">
                                <div class="col-md-4"><label class="form-label" for="participant-employee-number">NIK *</label><input id="participant-employee-number" class="form-control" required maxlength="100"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-full-name">EMPLOYEE_NAME *</label><input id="participant-full-name" class="form-control" required maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-employee-type">EMPLOYEE_TYPE</label><input id="participant-employee-type" class="form-control" maxlength="100"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-position">POSITION_NAME</label><input id="participant-position" class="form-control" maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-department">ORG_NAME</label><input id="participant-department" class="form-control" maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-gender">GENDER</label><input id="participant-gender" class="form-control" maxlength="50"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-email">EMAIL</label><input id="participant-email" type="email" class="form-control" maxlength="254"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-camp">CAMP</label><input id="participant-camp" class="form-control" maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-transport">TRANSPORT</label><input id="participant-transport" class="form-control" maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-vehicle">MOBIL</label><input id="participant-vehicle" class="form-control" maxlength="200"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-group-number">GROUP_NUMBER</label><input id="participant-group-number" class="form-control" maxlength="100"></div>
                                <div class="col-md-4"><label class="form-label" for="participant-status">Status peserta</label><select id="participant-status" class="form-select"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
                            </div>
                            <div class="button-row mt-3"><button id="participant-save" class="btn btn-primary" type="submit">Simpan peserta</button><button id="participant-cancel" class="btn btn-outline-secondary" type="button">Batal</button></div>
                        </form>
                    </article>
                }
                <article class="panel">
                    <div class="panel-heading"><div><h3>Daftar peserta</h3><p id="participant-page">Memuat data peserta</p></div></div>
                    <input id="participant-search" class="form-control" placeholder="Cari berdasarkan NIK, nama, jabatan, departemen, email, camp, transport, atau group number" aria-label="Cari peserta">
                    <div class="table-responsive mt-3"><table class="table table-hover align-middle participant-table"><thead><tr><th>NIK</th><th>EMPLOYEE_NAME</th><th>EMPLOYEE_TYPE</th><th>POSITION_NAME</th><th>ORG_NAME</th><th>GENDER</th><th>EMAIL</th><th>CAMP</th><th>TRANSPORT</th><th>MOBIL</th><th>GROUP_NUMBER</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="participant-table"></tbody></table></div>
                    <div class="d-flex justify-content-between align-items-center mt-3"><button id="participant-prev" class="btn btn-sm btn-outline-secondary">Sebelumnya</button><small id="participant-page-control" class="text-secondary"></small><button id="participant-next" class="btn btn-sm btn-outline-secondary">Berikutnya</button></div>
                    <div id="qr-output" class="qr-output d-none"><div id="qr-code"></div><p id="qr-caption" class="small mt-2 mb-2"></p><button id="download-qr" class="btn btn-sm btn-primary">Unduh QR PNG</button></div>
                </article>
            }
            else if (Model.Page == "data" && (canManage || role == "VIEWER"))
            {
                @if (canManage)
                {
                    <article class="panel mb-4" id="new-event-form">
                        <div class="panel-heading"><div><h3 id="event-form-title">Buat kegiatan</h3><p>Data disimpan pada database OMS</p></div></div>
                        <form id="create-event-form">
                            <input id="editing-event-id" type="hidden">
                            <div class="row g-3">
                                <div class="col-md-4"><label class="form-label" for="new-event-code">Kode</label><input id="new-event-code" class="form-control" maxlength="40" required></div>
                                <div class="col-md-8"><label class="form-label" for="new-event-name">Nama kegiatan</label><input id="new-event-name" class="form-control" maxlength="120" required></div>
                                <div class="col-md-4"><label class="form-label" for="new-event-status">Status</label><select id="new-event-status" class="form-select"><option>Draft</option><option>Published</option><option>Ongoing</option><option>Completed</option><option>Cancelled</option></select></div>
                                <div class="col-md-4"><label class="form-label" for="new-event-start">Tanggal mulai</label><input id="new-event-start" class="form-control" type="date"></div>
                                <div class="col-md-4"><label class="form-label" for="new-event-end">Tanggal selesai</label><input id="new-event-end" class="form-control" type="date"></div>
                                <div class="col-12"><label class="form-label" for="new-event-location">Lokasi</label><input id="new-event-location" class="form-control" maxlength="200"></div>
                                <div class="col-12"><label class="form-label" for="new-event-description">Deskripsi</label><textarea id="new-event-description" class="form-control" rows="2" maxlength="1000"></textarea></div>
                            </div>
                            <div id="create-event-status" class="alert d-none mt-3 mb-0" role="status" aria-live="polite"></div>
                            <div class="button-row mt-3">
                                <button id="create-event-submit" class="btn btn-primary" type="submit">Simpan kegiatan</button>
                                <button id="cancel-event-edit" class="btn btn-outline-secondary d-none" type="button">Batal edit</button>
                            </div>
                        </form>
                    </article>
                }
                <article class="panel mb-4">
                    <div class="panel-heading"><div><h3>Daftar kegiatan</h3><p>Pilih kegiatan aktif dari pemilih di bagian atas halaman</p></div></div>
                    <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Kode</th><th>Nama kegiatan</th><th>Tanggal</th><th>Lokasi</th><th>Status</th>@if (canManage)
                    {
                        <th>Aksi</th>
                    }</tr></thead><tbody>
                    @foreach (var item in Model.Events)
                    {
                        <tr>
                            <td>@item.EventCode</td><td>@item.EventName</td><td>@item.StartDate</td><td>@item.Location</td><td><span class="badge text-bg-light">@item.Status</span></td>
                            @if (canManage)
                            {
                                <td><div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-sm btn-outline-primary" type="button"
                                            data-edit-event="@item.EventId"
                                            data-code="@item.EventCode"
                                            data-name="@item.EventName"
                                            data-description="@item.Description"
                                            data-start-date="@item.StartDate"
                                            data-end-date="@item.EndDate"
                                            data-location="@item.Location"
                                            data-status="@item.Status">Edit</button>
                                    <button class="btn btn-sm btn-outline-danger" type="button" data-delete-event="@item.EventId">Hapus</button>
                                </div></td>
                            }
                        </tr>
                    }
                    </tbody></table></div>
                </article>
                @if (canManage && selectedEvent is not null)
                {
                    var agenda = Model.ScheduleItems ?? [];
                    <article class="panel mb-4" id="schedule-management">
                        <div class="panel-heading">
                            <div><h3>Rundown kegiatan</h3><p>Atur agenda lintas hari. Waktu menggunakan WIB (Jakarta).</p></div>
                            <a class="btn btn-outline-primary" href="/event/@selectedEvent.EventId/schedule" target="_blank" rel="noopener">View Schedule</a>
                        </div>
                        <form id="schedule-item-form" class="mb-4">
                            <input id="schedule-session-id" type="hidden">
                            <div class="row g-3">
                                <div class="col-lg-6"><label class="form-label" for="schedule-name">Nama kegiatan</label><input id="schedule-name" class="form-control" maxlength="160" required placeholder="Contoh: Persiapan keberangkatan"></div>
                                <div class="col-lg-3"><label class="form-label" for="schedule-start">Waktu mulai (WIB)</label><input id="schedule-start" class="form-control" type="datetime-local" required></div>
                                <div class="col-lg-3"><label class="form-label" for="schedule-end">Waktu selesai (WIB)</label><input id="schedule-end" class="form-control" type="datetime-local" required></div>
                                <div class="col-lg-5"><label class="form-label" for="schedule-location">Lokasi (opsional)</label><input id="schedule-location" class="form-control" maxlength="200"></div>
                                <div class="col-lg-5"><label class="form-label" for="schedule-description">Keterangan (opsional)</label><input id="schedule-description" class="form-control" maxlength="1000"></div>
                                <div class="col-lg-2"><label class="form-label" for="schedule-status">Status</label><select id="schedule-status" class="form-select"><option value="Active">Tampilkan</option><option value="Inactive">Sembunyikan</option></select></div>
                            </div>
                            <div id="schedule-form-status" class="alert d-none mt-3 mb-0" role="status" aria-live="polite"></div>
                            <div class="button-row mt-3">
                                <button id="schedule-save" class="btn btn-primary" type="submit">Tambah agenda</button>
                                <button id="schedule-cancel" class="btn btn-outline-secondary d-none" type="button">Batal edit</button>
                            </div>
                        </form>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead><tr><th>Waktu (WIB)</th><th>Agenda</th><th>Lokasi</th><th>Status</th><th>Aksi</th></tr></thead>
                                <tbody>
                                @foreach (var item in agenda)
                                {
                                    <tr>
                                        <td class="text-nowrap">@item.StartTime.Replace("T", " ") – @item.EndTime.Replace("T", " ")</td>
                                        <td><strong>@item.SessionName</strong>@if (!string.IsNullOrWhiteSpace(item.Description)) { <div class="small text-secondary">@item.Description</div> }</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Location) ? "—" : item.Location)</td>
                                        <td><span class="badge @(item.Status == "Active" ? "text-bg-success" : "text-bg-secondary")">@(item.Status == "Active" ? "Ditampilkan" : "Disembunyikan")</span></td>
                                        <td><div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-primary" type="button"
                                                    data-edit-schedule="@item.SessionId"
                                                    data-name="@item.SessionName"
                                                    data-description="@item.Description"
                                                    data-start="@item.StartTime"
                                                    data-end="@item.EndTime"
                                                    data-location="@item.Location"
                                                    data-status="@item.Status">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" type="button" data-delete-schedule="@item.SessionId">Hapus</button>
                                        </div></td>
                                    </tr>
                                }
                                @if (agenda.Count == 0)
                                {
                                    <tr><td colspan="5" class="text-secondary">Belum ada rundown acara</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </article>
                }
                @if (selectedEvent is not null)
                {
                    <article class="panel">
                        <div class="panel-heading"><div><h3>Laporan kehadiran</h3><p id="report-page-label">Tabel peserta dan status check-in kegiatan terpilih</p></div><a class="btn btn-outline-primary" href="/api/oms/reports/attendance.csv?eventId=@selectedEvent.EventId">Unduh CSV</a></div>
                        <div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>NIK</th><th>Nama</th><th>Departemen</th><th>Status</th><th>Waktu check-in</th><th>Waktu check-out</th><th>Metode</th></tr></thead><tbody id="attendance-report-body"><tr><td colspan="7" class="text-secondary">Memuat laporan</td></tr></tbody></table></div>
                        <div class="d-flex justify-content-between align-items-center mt-3"><button id="report-prev" class="btn btn-sm btn-outline-secondary">Sebelumnya</button><small id="report-page-control" class="text-secondary"></small><button id="report-next" class="btn btn-sm btn-outline-secondary">Berikutnya</button></div>
                    </article>
                }
                else
                {
                    <article class="panel"><h3>Laporan kehadiran</h3><p class="text-secondary mb-0">Buat dan pilih kegiatan untuk menampilkan tabel laporan serta unduhan CSV</p></article>
                }
            }
        </section>
        <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
    </main>
</div>
<meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
