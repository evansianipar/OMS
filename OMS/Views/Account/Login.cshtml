@{
    ViewData["Title"] = "Masuk";
}
<div class="auth-card">
    <div class="brand-mark">O</div>
    <p class="eyebrow mt-4">OUTING MANAGEMENT SYSTEM</p>
    <h1>Kelola outing dengan lebih mudah</h1>
    <p class="text-secondary">Masuk menggunakan akun Google Workspace @((string?)ViewData["GoogleDomain"] ?? "wom.co.id") yang telah terdaftar sebagai panitia.</p>
    <a class="btn btn-primary w-100 mt-3" href="/account/login">Masuk dengan Google Workspace</a>
</div>
